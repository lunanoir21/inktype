# SQLite database file (relative paths are resolved from apps/web/prisma).
DATABASE_URL="file:./dev.db"

# Allow new local accounts to be created. Set to "false" after creating yours
# on a public instance.
ALLOW_REGISTRATION="true"

# Project Gutenberg site used for catalog search and for downloading book texts.
# Books are fetched only when a reader opens them, then cached in SQLite.
GUTENBERG_MIRROR="https://www.gutenberg.org"

# Mark session cookies as Secure. Set to "true" when served over HTTPS.
COOKIE_SECURE="false"
